{
  "kind": "collectionType",
  "collectionName": "credentials",
  "info": {
    "singularName": "credential",
    "pluralName": "credentials",
    "displayName": "Credential",
    "description": "Open Badges 3.0 Credential (Badge Award)"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "credentialId": {
      "type": "string",
      "required": true,
      "unique": true,
      "minLength": 36,
      "maxLength": 255,
      "regex": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "type": {
      "type": "json",
      "default": [
        "VerifiableCredential",
        "OpenBadgeCredential"
      ]
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "issuanceDate": {
      "type": "datetime",
      "required": true
    },
    "awardedDate": {
      "type": "datetime",
      "description": "When the learning was actually achieved, which can be long before the credential was issued (e.g. a 2023 workshop recognised in 2026). Serialized as credentialSubject.awardedDate per Open Badges 3.0, and covered by the signature so the date cannot be altered afterwards. Optional: absent on credentials earned and issued at the same time."
    },
    "expirationDate": {
      "type": "datetime"
    },
    "achievement": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::achievement.achievement",
      "inversedBy": "credentials"
    },
    "issuer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::profile.profile",
      "inversedBy": "issuedCredentials"
    },
    "recipient": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::profile.profile",
      "inversedBy": "receivedCredentials"
    },
    "evidence": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::evidence.evidence",
      "mappedBy": "credential"
    },
    "narrative": {
      "type": "text"
    },
    "proof": {
      "type": "component",
      "repeatable": true,
      "component": "badge.proof"
    },
    "revoked": {
      "type": "boolean",
      "default": false
    },
    "revocationReason": {
      "type": "text"
    },
    "statusList": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::revocation-list.revocation-list"
    },
    "statusListIndex": {
      "type": "integer"
    }
  }
}
